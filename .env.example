# Create a Resend API key and keep it server-side (never add NEXT_PUBLIC_ to this name).
RESEND_API_KEY=re_your_resend_api_key

# Use a sender address on a domain verified in your Resend account.
RESEND_FROM_EMAIL="MuForge Website <enquiries@your-verified-domain.com>"

# --- MuForge ERP (/admin) ------------------------------------------------
# First admin account. Used only while the ERP has no users: the first login
# with these creates the account. Afterwards they are ignored, so remove the
# password from this file and manage users under Settings > Users.
ERP_ADMIN_EMAIL=you@example.com
ERP_ADMIN_PASSWORD=choose-a-long-passphrase
ERP_ADMIN_NAME="Your Name"

# Optional. Where the SQLite database lives. Defaults to ./data/muforge-erp.sqlite.
# Must be on a persistent disk that survives restarts and redeploys.
# ERP_DATABASE_PATH=/var/lib/muforge/muforge-erp.sqlite

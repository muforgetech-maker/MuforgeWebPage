# Create a Resend API key and keep it server-side (never add NEXT_PUBLIC_ to this name).
RESEND_API_KEY=re_your_resend_api_key

# Use a sender address on a domain verified in your Resend account.
RESEND_FROM_EMAIL="MuForge Website <enquiries@your-verified-domain.com>"

# --- MuForge ERP (/admin) ------------------------------------------------
# First admin account. Used only while the ERP has no users: the first login
# with these creates the account. Afterwards they are ignored, so remove the
# password from this file and manage users under Settings > Users.
ERP_ADMIN_EMAIL=you@example.com
ERP_ADMIN_PASSWORD=choose-a-long-passphrase
ERP_ADMIN_NAME="Your Name"

# The Supabase Postgres database behind the ERP. Required.
#
# Use the TRANSACTION POOLER string, not the direct connection:
#   Supabase dashboard > Connect > Transaction pooler (port 6543)
# Serverless instances are created and destroyed constantly, and the pooler is
# what stops that from opening thousands of Postgres connections.
#
# This contains the database password. Keep it out of git and never prefix it
# with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Optional. Sockets each running instance may open. The pooler does the real
# multiplexing, so this stays small.
# ERP_DB_POOL_MAX=3
